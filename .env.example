# ============================================================================
# Módulo de Rótulo Nutricional — variáveis de ambiente
# Copie este arquivo para .env e preencha conforme sua preferência
# ============================================================================

# ----------------------------------------------------------------------------
# Provider de código de barras
# ----------------------------------------------------------------------------
ROTULO_BARCODE_PROVIDER=openfoodfacts

# ----------------------------------------------------------------------------
# Provider de visão (LLM multimodal) — ESCOLHA UMA DAS OPÇÕES ABAIXO
# ----------------------------------------------------------------------------
ROTULO_VISION_PROVIDER=openai_compat

# Opção 1 — OpenAI GPT-4o-mini (mais confiável, custo moderado)
# ROTULO_VISION_BASE_URL=https://api.openai.com/v1
# ROTULO_VISION_MODEL=gpt-4o-mini
# ROTULO_VISION_API_KEY=sk-...

# Opção 2 — Google Gemini 1.5 Flash (melhor custo-benefício, gratuito até certo limite)
# ROTULO_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ROTULO_VISION_MODEL=gemini-1.5-flash
# ROTULO_VISION_API_KEY=...

# Opção 3 — Moonshot Kimi (exemplo da especificação)
# ROTULO_VISION_BASE_URL=https://api.moonshot.cn/v1
# ROTULO_VISION_MODEL=kimi-latest
# ROTULO_VISION_API_KEY=sk-...

# Limiar de confiança mínima para aceitar resposta da IA (0.0 a 1.0)
ROTULO_CONFIANCA_MINIMA=0.80

# ----------------------------------------------------------------------------
# Provider OCR (fallback quando visão não está configurada ou falha)
# ----------------------------------------------------------------------------
ROTULO_OCR_PROVIDER=tesseract
# Windows — descomente e ajuste o caminho se necessário:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
